# Copy to backend/.env (never commit the real one).
# The Anthropic key is read ONLY on the backend. It is never sent to the browser.

# Anthropic API key for the LLM calls (translate, openers, stuck, review).
# If unset, the backend runs in MOCK LLM mode: canned deterministic responses
# are returned so the full UI flow can be demoed without a key.
ANTHROPIC_API_KEY=

# Override model identifiers (defaults verified against Anthropic docs 2026-09-23):
#   live calls -> claude-haiku-4-5 (fast/cheap)
#   review     -> claude-sonnet-5  (stronger, non-live)
# LENGUA_LIVE_MODEL=claude-haiku-4-5
# LENGUA_REVIEW_MODEL=claude-sonnet-5

# Force mock LLM responses even when a key is present (1 = mock).
# LENGUA_MOCK_LLM=0

# Mock STT replay scripts (JSONL; see samples/*.script.jsonl).
# LENGUA_SCRIPT_GRANDMA=samples/grandma.script.jsonl
# LENGUA_SCRIPT_ME=samples/me.script.jsonl

# Port for the backend (serves the web UI too).
# PORT=3000
